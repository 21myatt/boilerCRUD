{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imsys-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-09",
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_NAME": "imsys",
    "APP_ENV": "development"
  },
  "env": {
    "staging": {
      "name": "imsys-edge-staging",
      "vars": {
        "APP_ENV": "staging"
      }
    },
    "production": {
      "name": "imsys-edge-production",
      "vars": {
        "APP_ENV": "production"
      }
    }
  }
}
