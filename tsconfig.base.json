{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@ui/*": ["packages/ui/*"],
      "@types/*": ["packages/types/*"],
      "@api-client/*": ["packages/api-client/*"],
      "@db/*": ["packages/db/*"],
      "@auth/*": ["packages/auth/*"],
      "@utils/*": ["packages/utils/*"]
    },
    "noEmit": true,
    "skipLibCheck": true
  }
}

