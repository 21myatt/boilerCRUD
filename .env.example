DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
APP_ENV=development
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]
SUPABASE_SECRET_KEY=[YOUR-SUPABASE-SECRET-KEY]
SUPABASE_ACCESS_TOKEN=[YOUR-SUPABASE-MANAGEMENT-API-TOKEN]
INVITE_REDIRECT_TO=http://localhost:5173
INVITE_REDIRECT_ORIGINS=http://localhost:5173,https://[YOUR-WORKER-DOMAIN]
SUPABASE_AUTH_SITE_URL=http://localhost:5173
SUPABASE_AUTH_URI_ALLOW_LIST=http://localhost:5173,http://localhost:5173/**,https://[YOUR-WORKER-DOMAIN],https://[YOUR-WORKER-DOMAIN]/**
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,https://[YOUR-WORKER-DOMAIN]
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_ADMIN_MAX=20
SUPABASE_PASSWORD_REQUIRED_CHARACTERS=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789
VITE_API_URL=/api
VITE_USE_LOCAL_API=false
VITE_APP_ENV=development
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
VITE_SENTRY_DSN=[YOUR-SENTRY-DSN]
VITE_POSTHOG_KEY=[YOUR-POSTHOG-PROJECT-KEY]
VITE_POSTHOG_HOST=https://app.posthog.com

# Optional legacy Node API local target
# Set VITE_API_URL=http://localhost:4000 if you want the Vite dev server to call apps/api directly.

# Optional Cloudflare edge gateway references for apps/cloudflare/.dev.vars
CF_API_ORIGIN=http://localhost:4000
CF_CORS_ORIGINS=http://localhost:5173,http://localhost:8081
